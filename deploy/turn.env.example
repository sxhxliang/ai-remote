# The VPS public IPv4 address, including when the host has a private NIC.
PUBLIC_IP=
TURN_USER=ollama-link
TURN_PASS=
REALM=webrtc-ollama
TURN_UDP_BIND=0.0.0.0:3478
TURN_TCP_BIND=0.0.0.0:3478
# One TLS listener serves the page, WSS and TURN-over-TLS on the same IP:443.
TURN_TLS_BIND=0.0.0.0:443
TLS_CERT=/etc/ollama-link/tls/fullchain.pem
TLS_KEY=/etc/ollama-link/tls/privkey.pem
HTTPS_UPSTREAM=127.0.0.1:8080
RELAY_BIND=0.0.0.0
RELAY_MIN_PORT=49160
RELAY_MAX_PORT=49200
TURN_IDLE_TIMEOUT_SECS=600
