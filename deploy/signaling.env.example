# Set to 0.0.0.0:8080 for direct public access, or 127.0.0.1:8080 if behind Nginx/TURN.
SIGNALING_BIND=0.0.0.0:8080
SIGNALING_TOKEN=
FRONTEND_DIR=/opt/ollama-link/frontend
