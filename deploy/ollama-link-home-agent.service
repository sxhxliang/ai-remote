[Unit]
Description=Ollama Link home WebRTC Agent
Wants=network-online.target
After=network-online.target ollama.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=ollama-link
Group=ollama-link
WorkingDirectory=/opt/ollama-link
EnvironmentFile=/etc/ollama-link/home-agent.env
ExecStart=/opt/ollama-link/bin/home-agent
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
