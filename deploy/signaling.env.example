# Set to 0.0.0.0:8080 for direct public access, or 127.0.0.1:8080 if behind Nginx/TURN.
SIGNALING_BIND=0.0.0.0:8080
SIGNALING_TOKEN=
FRONTEND_DIR=/opt/ollama-link/frontend
# Optional room-specific secrets, replacing the shared token:
# ROOM_TOKENS_JSON='{"my-room":"a-random-secret-of-at-least-16-characters"}'
# STUN/TURN sent to the browser and the home Agent after they authenticate.
# List UDP and TCP TURN so browsers on UDP-blocked networks can still relay.
STUN_URL=stun:chat.example.com:3478
TURN_URL=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp
TURN_USER=ollama-link
TURN_PASS=
