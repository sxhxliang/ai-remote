# The home Agent needs outbound WSS and UDP access to the VPS.
SIGNALING_URL=wss://chat.example.com/ws
ROOM_ID=my-room
SIGNALING_TOKEN=
OLLAMA_BASE=http://127.0.0.1:11434
ALLOWED_PATHS=/api/chat,/api/generate,/api/tags
STUN_URL=stun:chat.example.com:3478
TURN_URL=turn:chat.example.com:3478?transport=udp
TURN_USER=ollama-link
TURN_PASS=
REQUEST_TIMEOUT_SECS=600
FORCE_RELAY=false
# Optional additional ICE servers. Agent URLs use UDP; the browser supports TCP/TLS.
ICE_SERVERS_JSON=[]
